{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyweaver.local/schemas/index.schema.json",
  "title": "StoryWeaver State Index",
  "type": "object",
  "required": [
    "generated_at",
    "schema_version",
    "summary",
    "latest_chapter",
    "entities",
    "chapters",
    "open_loops",
    "warnings"
  ],
  "properties": {
    "generated_at": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "minLength": 1 },
    "summary": {
      "type": "object",
      "required": [
        "characters",
        "items",
        "scenes",
        "organizations",
        "concepts",
        "timeline_events",
        "plot_threads",
        "relationships",
        "chapters",
        "briefs",
        "extractions",
        "reviews",
        "gates"
      ],
      "properties": {
        "characters": { "type": "number", "minimum": 0 },
        "items": { "type": "number", "minimum": 0 },
        "scenes": { "type": "number", "minimum": 0 },
        "organizations": { "type": "number", "minimum": 0 },
        "concepts": { "type": "number", "minimum": 0 },
        "timeline_events": { "type": "number", "minimum": 0 },
        "plot_threads": { "type": "number", "minimum": 0 },
        "relationships": { "type": "number", "minimum": 0 },
        "chapters": { "type": "number", "minimum": 0 },
        "briefs": { "type": "number", "minimum": 0 },
        "extractions": { "type": "number", "minimum": 0 },
        "reviews": { "type": "number", "minimum": 0 },
        "gates": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "latest_chapter": { "type": "number", "minimum": 0 },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "name", "source", "refs_in"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": [
              "character",
              "item",
              "scene",
              "organization",
              "concept",
              "timeline_event",
              "plot_thread",
              "relationship"
            ]
          },
          "name": { "type": "string" },
          "source": { "type": "string", "minLength": 1 },
          "last_updated_chapter": { "type": ["number", "null"], "minimum": 0 },
          "refs_in": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "chapter",
          "title",
          "status",
          "source",
          "has_manuscript",
          "has_brief",
          "has_extraction",
          "has_review",
          "has_gate",
          "word_count",
          "state_delta_counts"
        ],
        "properties": {
          "chapter": { "type": "number", "minimum": 1 },
          "title": { "type": "string" },
          "status": { "type": "string" },
          "source": { "type": "string", "minLength": 1 },
          "has_manuscript": { "type": "boolean" },
          "has_brief": { "type": "boolean" },
          "has_extraction": { "type": "boolean" },
          "has_review": { "type": "boolean" },
          "has_gate": { "type": "boolean" },
          "gate_status": { "type": "string" },
          "gate_score": { "type": ["number", "null"], "minimum": 0 },
          "word_count": { "type": "number", "minimum": 0 },
          "state_delta_counts": {
            "type": "object",
            "required": [
              "characters",
              "items",
              "scenes",
              "organizations",
              "concepts",
              "timeline_events",
              "plot_threads",
              "relationships"
            ],
            "properties": {
              "characters": { "type": "number", "minimum": 0 },
              "items": { "type": "number", "minimum": 0 },
              "scenes": { "type": "number", "minimum": 0 },
              "organizations": { "type": "number", "minimum": 0 },
              "concepts": { "type": "number", "minimum": 0 },
              "timeline_events": { "type": "number", "minimum": 0 },
              "plot_threads": { "type": "number", "minimum": 0 },
              "relationships": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "open_loops": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chapter", "status", "text", "source"],
        "properties": {
          "chapter": { "type": "number", "minimum": 1 },
          "status": { "type": "string", "enum": ["introduced", "advanced", "resolved"] },
          "text": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["level", "message"],
        "properties": {
          "level": { "type": "string", "enum": ["info", "warning", "critical"] },
          "message": { "type": "string", "minLength": 1 },
          "source": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
