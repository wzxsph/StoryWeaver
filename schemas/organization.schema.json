{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyweaver.local/schemas/organization.schema.json",
  "title": "StoryWeaver Organization",
  "type": "object",
  "required": ["id", "name", "type"],
  "properties": {
    "id": { "type": "string", "pattern": "^org_[0-9]{3,}$" },
    "name": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "minLength": 1 },
    "public_face": { "type": "string" },
    "private_agenda": { "type": "string" },
    "resources": { "type": "array", "items": { "type": "string" } },
    "fears": { "type": "array", "items": { "type": "string" } },
    "territory": { "type": "array", "items": { "type": "string" } },
    "members": { "type": "array", "items": { "type": "string" } },
    "relationships": { "type": "object" }
  },
  "additionalProperties": true
}
