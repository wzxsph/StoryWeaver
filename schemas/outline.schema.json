{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyweaver.local/schemas/outline.schema.json",
  "title": "StoryWeaver Project Outline",
  "type": "object",
  "required": ["kind", "generated_at", "schema_version", "title", "premise", "synopsis", "volumes"],
  "properties": {
    "kind": { "type": "string", "enum": ["outline"] },
    "generated_at": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "premise": { "type": "string" },
    "logline": { "type": "string" },
    "synopsis": { "type": "string" },
    "themes": { "type": "array", "items": { "type": "string" } },
    "volumes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["volume", "title", "scope", "summary"],
        "properties": {
          "volume": { "type": "number", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "minLength": 1 },
          "summary": { "type": "string" },
          "goal": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
