{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyweaver.local/schemas/plot-thread.schema.json",
  "title": "StoryWeaver Plot Thread",
  "type": "object",
  "required": ["id", "name", "status", "progress"],
  "properties": {
    "id": { "type": "string", "pattern": "^plot_[0-9]{3,}$" },
    "name": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["active", "dormant", "completed", "abandoned"] },
    "progress": { "type": "number", "minimum": 0 },
    "description": { "type": "string" },
    "started_chapter": { "type": "number", "minimum": 1 },
    "last_updated_chapter": { "type": "number", "minimum": 0 },
    "related_events": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
