{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyweaver.local/schemas/review.schema.json",
  "title": "StoryWeaver Review Report",
  "type": "object",
  "required": ["chapter", "timestamp", "scope", "violations", "passed_dimensions", "summary"],
  "properties": {
    "chapter": { "type": "number", "minimum": 1 },
    "timestamp": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "enum": ["basic", "extended", "all"] },
    "passed": { "type": "boolean" },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "dimension", "description", "location", "suggestion"],
        "properties": {
          "severity": { "type": "string", "enum": ["critical", "warning", "info"] },
          "dimension": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "location": { "type": "string" },
          "suggestion": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "passed_dimensions": { "type": "array", "items": { "type": "string" } },
    "summary": {
      "type": "object",
      "required": ["critical_count", "warning_count", "info_count"],
      "properties": {
        "critical_count": { "type": "number", "minimum": 0 },
        "warning_count": { "type": "number", "minimum": 0 },
        "info_count": { "type": "number", "minimum": 0 },
        "passed": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
