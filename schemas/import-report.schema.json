{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyweaver.local/schemas/import-report.schema.json",
  "title": "StoryWeaver Import Report",
  "type": "object",
  "required": [
    "generated_at",
    "schema_version",
    "source",
    "start_chapter",
    "end_chapter",
    "chapters",
    "warnings"
  ],
  "properties": {
    "generated_at": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "start_chapter": { "type": "number", "minimum": 1 },
    "end_chapter": { "type": "number", "minimum": 1 },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chapter", "title", "word_count", "manuscript", "contract", "brief"],
        "properties": {
          "chapter": { "type": "number", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "word_count": { "type": "number", "minimum": 0 },
          "manuscript": { "type": "string", "minLength": 1 },
          "contract": { "type": "string", "minLength": 1 },
          "brief": { "type": "string", "minLength": 1 },
          "source": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["level", "message"],
        "properties": {
          "level": { "type": "string", "enum": ["info", "warning", "critical"] },
          "message": { "type": "string", "minLength": 1 },
          "source": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
