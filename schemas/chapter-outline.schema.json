{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyweaver.local/schemas/chapter-outline.schema.json",
  "title": "StoryWeaver Chapter Outline",
  "type": "object",
  "required": [
    "kind",
    "generated_at",
    "schema_version",
    "chapter",
    "title",
    "chapter_goal",
    "reader_promise",
    "conflict_axis",
    "turning_point",
    "summary",
    "state_delta_plan"
  ],
  "properties": {
    "kind": { "type": "string", "enum": ["chapter"] },
    "generated_at": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "minLength": 1 },
    "chapter": { "type": "number", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "chapter_goal": { "type": "string", "minLength": 1 },
    "reader_promise": { "type": "string", "minLength": 1 },
    "conflict_axis": { "type": "string", "minLength": 1 },
    "turning_point": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "scene_beats": { "type": "array", "items": { "type": "string" } },
    "state_delta_plan": {
      "type": "object",
      "required": ["characters", "items", "scenes", "organizations", "concepts", "timeline_events", "plot_threads", "relationships"],
      "properties": {
        "characters": { "type": "array", "items": { "type": "string", "pattern": "^char_[0-9]{3,}$" } },
        "items": { "type": "array", "items": { "type": "string", "pattern": "^item_[0-9]{3,}$" } },
        "scenes": { "type": "array", "items": { "type": "string", "pattern": "^scene_[0-9]{3,}$" } },
        "organizations": { "type": "array", "items": { "type": "string", "pattern": "^org_[0-9]{3,}$" } },
        "concepts": { "type": "array", "items": { "type": "string", "pattern": "^concept_[0-9]{3,}$" } },
        "timeline_events": { "type": "array", "items": { "type": "string", "pattern": "^event_[0-9]{3,}$" } },
        "plot_threads": { "type": "array", "items": { "type": "string", "pattern": "^plot_[0-9]{3,}$" } },
        "relationships": { "type": "array", "items": { "type": "string", "pattern": "^rel_[0-9]{3,}$" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
