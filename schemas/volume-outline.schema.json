{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyweaver.local/schemas/volume-outline.schema.json",
  "title": "StoryWeaver Volume Outline",
  "type": "object",
  "required": ["kind", "generated_at", "schema_version", "volume", "title", "scope", "summary", "chapters"],
  "properties": {
    "kind": { "type": "string", "enum": ["volume"] },
    "generated_at": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "minLength": 1 },
    "volume": { "type": "number", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "number", "minimum": 1 },
        "to": { "type": "number", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "summary": { "type": "string" },
    "arc_goal": { "type": "string" },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chapter", "title", "chapter_goal"],
        "properties": {
          "chapter": { "type": "number", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "chapter_goal": { "type": "string" },
          "turning_point": { "type": "string" },
          "status": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
